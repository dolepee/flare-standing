{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd app && npm ci && npm run build",
  "outputDirectory": "app/dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/demo", "destination": "/demo/index.html" },
    { "source": "/evidence", "destination": "/evidence/index.html" },
    { "source": "/plans", "destination": "/plans/index.html" },
    { "source": "/mandates", "destination": "/mandates/index.html" },
    { "source": "/merchant", "destination": "/merchant/index.html" },
    { "source": "/legacy-recovery", "destination": "/legacy-recovery/index.html" },
    { "source": "/:path((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
